  "connections": [
    [ "oled1:GND", "esp:GND.1", "black", [] ],
    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:SCL", "esp:22", "yellow", [] ],
    [ "oled1:SDA", "esp:21", "green", [] ],
    [ "led_online:A", "esp:2", "green", [] ],
    [ "led_online:C", "esp:GND.1", "black", [] ],
    [ "led_alarm:A", "esp:4", "red", [] ],
    [ "led_alarm:C", "esp:GND.1", "black", [] ],
    [ "btn_toggle:1.l", "esp:18", "blue", [] ],
    [ "btn_toggle:2.r", "esp:GND.3", "black", [] ],
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ]
