    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": 30,
      "left": 260,
      "attrs": {
        "i2cAddress": "0x3c"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led_online",
      "top": 150,
      "left": 260,
      "attrs": {
        "color": "green",
        "label": "Online (GPIO 2)"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led_alarm",
      "top": 210,
      "left": 260,
      "attrs": {
        "color": "red",
        "label": "Offline Alert (GPIO 4)"
      }
