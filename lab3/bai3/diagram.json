{
  "version": 1,
  "author": "Quan",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led_status",
      "top": 40,
      "left": 250,
      "attrs": {
        "color": "yellow",
        "label": "Status LED (GPIO 2)"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_reset_wifi",
      "top": 140,
      "left": 250,
      "attrs": {
        "color": "blue",
        "label": "Hold 3s Reset WiFi (GPIO 18)"
      }
    }
  ],
  "connections": [
    [ "led_status:A", "esp:2", "yellow", [] ],
    [ "led_status:C", "esp:GND.1", "black", [] ],
    [ "btn_reset_wifi:1.l", "esp:18", "blue", [] ],
    [ "btn_reset_wifi:2.r", "esp:GND.3", "black", [] ],
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ]
  ]
}
