{
  "version": 1,
  "author": "Quan",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led_wifi",
      "top": 40,
      "left": 250,
      "attrs": {
        "color": "green",
        "label": "WiFi LED (GPIO 2)"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_toggle",
      "top": 140,
      "left": 250,
      "attrs": {
        "color": "red",
        "label": "Toggle Disconnect (GPIO 18)"
      }
    }
  ],
  "connections": [
    [ "led_wifi:A", "esp:2", "green", [] ],
    [ "led_wifi:C", "esp:GND.1", "black", [] ],
    [ "btn_toggle:1.l", "esp:18", "red", [] ],
    [ "btn_toggle:2.r", "esp:GND.3", "black", [] ],
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ]
  ]
}
